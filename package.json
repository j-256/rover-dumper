{
  "name": "rover-dumper",
  "version": "1.1.0",
  "description": "Bulk download your pet's photos from Rover.com",
  "type": "module",
  "private": true,
  "homepage": "https://rover-dumper.jklein.dev/",
  "repository": "j-256/rover-dumper",
  "scripts": {
    "setup": "git config core.hooksPath hooks",
    "build": "./build.sh",
    "screenshots": "node scripts/screenshots.mjs",
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "test": "npm run check:docs-cover && node --test 'test/**/*.test.js'",
    "version": "npm run build && git add dist/ index.html sitemap.xml robots.txt README.md"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.61.1"
  },
  "license": "MIT"
}
